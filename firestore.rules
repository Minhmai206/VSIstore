rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /customers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'phone', 'address', 'email'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'phone', 'address', 'email'
        ]);
      allow list, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.orderNumber == orderId
        && request.resource.data.orderStatus == 'Chờ xác nhận'
        && request.resource.data.createdAt is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.address is string
        && request.resource.data.city is string
        && request.resource.data.shippingMethod in ['standard', 'express']
        && request.resource.data.paymentMethod in ['cod', 'vietqr']
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.shippingFee is number
        && request.resource.data.shippingFee >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.keys().hasAll([
          'orderNumber', 'customerUid', 'createdAt', 'customerName',
          'phone', 'email', 'address', 'city', 'shippingMethod',
          'paymentMethod', 'paymentStatus', 'orderStatus',
          'estimatedDelivery', 'subtotal', 'discount', 'shippingFee',
          'total', 'items'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'customerUid', 'createdAt', 'customerName',
          'phone', 'email', 'address', 'city', 'shippingMethod',
          'paymentMethod', 'paymentStatus', 'orderStatus',
          'estimatedDelivery', 'subtotal', 'discount', 'shippingFee',
          'total', 'items', 'ewalletProvider', 'promoCode',
          'paymentReference'
        ])
        && (
          (request.resource.data.paymentMethod == 'cod'
            && request.resource.data.paymentStatus == 'Thanh toán khi nhận hàng'
            && !request.resource.data.keys().hasAny(['paymentReference']))
          ||
          (request.resource.data.paymentMethod == 'vietqr'
            && request.resource.data.paymentStatus == 'Chờ xác nhận thanh toán'
            && request.resource.data.keys().hasAny(['paymentReference'])
            && request.resource.data.paymentReference is string
            && request.resource.data.paymentReference.matches('^VSI[0-9]{17}$'))
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['orderStatus', 'paymentStatus'])
        && (
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['orderStatus'])
            && request.resource.data.orderStatus in [
              'Chờ xác nhận',
              'Đang đóng gói chống sốc',
              'Đang giao hàng',
              'Hoàn tất',
              'Đã hủy'
            ])
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus'])
            && resource.data.paymentMethod == 'vietqr'
            && resource.data.paymentStatus == 'Chờ xác nhận thanh toán'
            && resource.data.orderStatus != 'Đã hủy'
            && request.resource.data.paymentStatus == 'Đã xác nhận chuyển khoản')
        );

      allow delete: if false;
    }
  }
}
