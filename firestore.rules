rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /customers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'phone', 'address', 'email'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'phone', 'address', 'email'
        ]);
      allow list, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if signedIn()
        && orderId.matches('VSI-[a-f0-9]{32}')
        && request.resource.data.keys().hasAll([
          'orderNumber', 'customerUid', 'createdAt', 'customerName', 'phone',
          'email', 'address', 'city', 'shippingMethod', 'paymentMethod',
          'paymentStatus', 'orderStatus', 'estimatedDelivery', 'subtotal',
          'discount', 'shippingFee', 'total', 'items'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'customerUid', 'createdAt', 'customerName', 'phone',
          'email', 'address', 'city', 'shippingMethod', 'paymentMethod',
          'paymentStatus', 'orderStatus', 'estimatedDelivery', 'subtotal',
          'discount', 'shippingFee', 'total', 'items', 'promoCode',
          'paymentReference', 'quotedSubtotal', 'quotedDiscount',
          'quotedShippingFee', 'quotedTotal'
        ])
        && request.resource.data.orderNumber == orderId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 500
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 120
        && request.resource.data.shippingMethod in ['standard', 'express']
        && request.resource.data.paymentMethod in ['vietqr', 'cod']
        && request.resource.data.paymentStatus == 'awaiting_admin_review'
        && request.resource.data.orderStatus == 'Chờ duyệt giá và tồn kho'
        && request.resource.data.estimatedDelivery == ''
        && request.resource.data.subtotal == 0
        && request.resource.data.discount == 0
        && request.resource.data.shippingFee == 0
        && request.resource.data.total == 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && (
          !('promoCode' in request.resource.data)
          || request.resource.data.promoCode in ['MOCDAT10', 'FREESHIP']
        )
        && (
          !('paymentReference' in request.resource.data)
          || (
            request.resource.data.paymentMethod == 'vietqr'
            && request.resource.data.paymentReference == orderId
          )
        )
        && (
          request.resource.data.paymentMethod != 'vietqr'
          || request.resource.data.paymentReference == orderId
        )
        && (
          !('quotedSubtotal' in request.resource.data)
          || (
            request.resource.data.quotedSubtotal is int
            && request.resource.data.quotedSubtotal >= 0
          )
        )
        && (
          !('quotedDiscount' in request.resource.data)
          || (
            request.resource.data.quotedDiscount is int
            && request.resource.data.quotedDiscount >= 0
          )
        )
        && (
          !('quotedShippingFee' in request.resource.data)
          || (
            request.resource.data.quotedShippingFee is int
            && request.resource.data.quotedShippingFee >= 0
          )
        )
        && (
          !('quotedTotal' in request.resource.data)
          || (
            request.resource.data.quotedTotal is int
            && request.resource.data.quotedTotal >= 0
          )
        );

      allow update: if (
        isAdmin()
        && resource.data.paymentStatus != 'awaiting_admin_review'
        && resource.data.orderStatus != 'Chờ duyệt giá và tồn kho'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['orderStatus'])
        && request.resource.data.orderStatus in [
              'Chờ duyệt giá và tồn kho',
              'Chờ xác nhận',
              'Đang đóng gói chống sốc',
              'Đang giao hàng',
              'Hoàn tất',
              'Đã hủy'
            ]
      ) || (
        isAdmin()
        && resource.data.paymentStatus in [
          'awaiting_admin_review',
          'awaiting_confirmation'
        ]
        && resource.data.orderStatus == 'Chờ duyệt giá và tồn kho'
        && request.resource.data.orderStatus == 'Chờ xác nhận'
        && (
          (
            request.resource.data.paymentMethod == 'vietqr'
            && request.resource.data.paymentReference == orderId
            && request.resource.data.paymentStatus in [
              'pending_payment',
              'awaiting_confirmation'
            ]
          )
          || (
            request.resource.data.paymentMethod == 'cod'
            && request.resource.data.paymentStatus == 'Thanh toán khi nhận hàng'
          )
        )
        && request.resource.data.subtotal is int
        && request.resource.data.discount is int
        && request.resource.data.shippingFee is int
        && request.resource.data.total is int
        && request.resource.data.items is list
        && request.resource.data.estimatedDelivery is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'items', 'subtotal', 'discount', 'shippingFee', 'total',
            'orderStatus', 'paymentStatus', 'estimatedDelivery',
            'paymentReference'
          ])
      ) || (
        signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.paymentMethod == 'vietqr'
        && resource.data.paymentStatus in [
          'pending_payment',
          'awaiting_admin_review'
        ]
        && resource.data.orderStatus != 'Đã hủy'
        && request.resource.data.paymentStatus == 'awaiting_confirmation'
        && request.resource.data.paymentSubmittedAt is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentSubmittedAt'])
      ) || (
        isAdmin()
        && resource.data.paymentMethod == 'vietqr'
        && resource.data.paymentStatus == 'awaiting_confirmation'
        && resource.data.orderStatus != 'Đã hủy'
        && resource.data.orderStatus != 'Chờ duyệt giá và tồn kho'
        && request.resource.data.paymentStatus in ['paid', 'pending_payment']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'paymentStatus', 'paymentConfirmedAt', 'paymentNote',
            'paymentReviewedAt'
          ])
      );

      allow delete: if isAdmin();
    }
  }
}
